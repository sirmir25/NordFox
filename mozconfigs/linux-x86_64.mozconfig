# NordFox native Linux x86_64 release build.
ac_add_options --target=x86_64-pc-linux-gnu
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-debug-symbols

ac_add_options --with-app-name=nordfox
ac_add_options --with-branding=browser/branding/unofficial

ac_add_options --disable-lto
ac_add_options --enable-hardening
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-eme
ac_add_options --enable-sandbox
ac_add_options --without-wasm-sandboxed-libraries

export CFLAGS="-fstack-protector-all -D_FORTIFY_SOURCE=2 -fPIC"
export CXXFLAGS="-fstack-protector-all -D_FORTIFY_SOURCE=2 -fPIC"
export RUSTFLAGS="-C embed-bitcode=no"

ac_add_options --enable-optimize="-O2"
ac_add_options --enable-linker=lld

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-nordfox-linux
mk_add_options AUTOCLOBBER=1
