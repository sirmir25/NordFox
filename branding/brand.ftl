# NordFox branding strings (Fluent).
# Replaces the upstream Nightly strings in the `unofficial` branding tree.
# Installed by build.sh -> install_branding into:
#   <app>/Contents/Resources/browser/localization/en-US/branding/brand.ftl

-brand-shorter-name = NordFox
-brand-short-name = NordFox
-brand-shortcut-name = NordFox
-brand-full-name = NordFox
# This brand name is used where the underlying product name should stay
# stable across NordFox / LibreWolf / Firefox upstreams.
-brand-product-name = NordFox
-vendor-short-name = NordFox
trademarkInfo = { " " }
